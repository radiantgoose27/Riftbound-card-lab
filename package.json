{
  "name": "riftbound-card-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data": ".venv/bin/python -m pipeline.fetch_topdeck && .venv/bin/python -m pipeline.build_db && .venv/bin/python -m pipeline.analyze",
    "data:analyze": ".venv/bin/python -m pipeline.build_db && .venv/bin/python -m pipeline.analyze",
    "test": ".venv/bin/python -m pytest -q pipeline/tests"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
